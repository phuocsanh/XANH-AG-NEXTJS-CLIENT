    rejected: { label: "Từ chối", className: "bg-red-100 text-red-700 border-red-200 hover:bg-red-200" },
    draft: { label: "Bản nháp", className: "bg-slate-100 text-slate-700 border-slate-200 hover:bg-slate-200" },
    completed: { label: "Đã hoàn thành", className: "bg-emerald-100 text-emerald-700 border-emerald-200 hover:bg-emerald-200" },
    harvested: { label: "Đã thu hoạch", className: "bg-amber-100 text-amber-700 border-amber-200 hover:bg-amber-200" },
