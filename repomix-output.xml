                className='block py-2 text-white hover:text-yellow-300 font-medium text-sm transition-colors'
                onClick={() => setIsMobileMenuOpen(false)}
              >
                Liên hệ
              </Link>
            </div>
          </div>
        )}
    </nav>
  )
}
