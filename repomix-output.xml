                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                )}
              </div>
                  </>
                );
              })()}
            </>
          )}
        </div>

        <DialogFooter className="p-6 pt-0">
          {currentCrop && (
            <div className="w-full flex gap-3">
