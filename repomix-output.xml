              {/* Lấy diện tích đất (amountOfLand) - mặc định 1 nếu không có */}
              {(() => {
                const amountOfLand = currentCrop.amount_of_land || (currentCrop.field_area / 1000) || 1;
                const hasHarvest = (profitReport?.total_revenue ?? 0) > 0;
