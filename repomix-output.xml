  status?: string
}

export interface CustomerRewardHistoryItem {
  id: number
  customer_id: number
  customer_name?: string | null
  reward_threshold: number
  accumulated_amount: number
  reward_sequence: number
  season_names?: string[] | null
  reward_date: string
