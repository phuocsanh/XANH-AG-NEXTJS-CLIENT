    tillering: { label: "Đẻ nhánh", className: "bg-emerald-50 text-emerald-600 border-emerald-100" },
    panicle: { label: "Làm đòng", className: "bg-teal-50 text-teal-600 border-teal-100" },
    heading: { label: "Trổ bông", className: "bg-sky-50 text-sky-600 border-sky-100" },
    grain_filling: { label: "Vô gạo", className: "bg-blue-50 text-blue-600 border-blue-100" },
    ripening: { label: "Chín", className: "bg-yellow-50 text-yellow-600 border-yellow-100" },
    
    // Thanh toán & Hóa đơn
    paid: { label: "Đã thanh toán", className: "bg-emerald-100 text-emerald-700 border-emerald-200 hover:bg-emerald-200" },
    partial: { label: "Trả một phần", className: "bg-amber-100 text-amber-700 border-amber-200 hover:bg-amber-200" },
    unpaid: { label: "Chưa trả", className: "bg-rose-100 text-rose-700 border-rose-200 hover:bg-rose-200" },
    confirmed: { label: "Đã xác nhận", className: "bg-blue-100 text-blue-700 border-blue-200 hover:bg-blue-200" },
    cancelled: { label: "Đã hủy", className: "bg-red-100 text-red-700 border-red-200 hover:bg-red-200" },
    canceled: { label: "Đã hủy", className: "bg-red-100 text-red-700 border-red-200 hover:bg-red-200" },

    // Loại hoạt động canh tác (Activity Types)
    spraying: { label: "Phun thuốc", className: "bg-indigo-50 text-indigo-700 border-indigo-200" },
    fertilizing: { label: "Bón phân", className: "bg-emerald-50 text-emerald-700 border-emerald-200" },
    weeding: { label: "Làm cỏ", className: "bg-lime-50 text-lime-700 border-lime-200" },
    pest_control: { label: "Diệt sâu bệnh", className: "bg-red-50 text-red-700 border-red-200" },
    observation: { label: "Quan sát", className: "bg-amber-50 text-amber-700 border-amber-200" },
    
    // Hạng mục chi phí (Cost Categories)
    seed: { label: "Giống", className: "bg-lime-50 text-lime-700 border-lime-200" },
    fertilizer: { label: "Phân bón", className: "bg-green-50 text-green-700 border-green-200" },
    pesticide: { label: "Thuốc BVTV", className: "bg-teal-50 text-teal-700 border-teal-200" },
    labor: { label: "Nhân công", className: "bg-orange-50 text-orange-700 border-orange-200" },
    machinery: { label: "Máy móc", className: "bg-blue-50 text-blue-700 border-blue-200" },
    irrigation: { label: "Tưới tiêu", className: "bg-cyan-50 text-cyan-700 border-cyan-200" },
    other: { label: "Khác", className: "bg-gray-100 text-gray-700 border-gray-200" },
  }

  // Ưu tiên: customConfig > defaultStatusConfig
  const config = customConfig[status] || defaultStatusConfig[status] || { label: status }
  
  const displayText = label || config.label
  const finalClassName = cn(
    "font-bold uppercase tracking-wide transition-colors inline-flex items-center",
    unstyled ? "" : "px-2 py-0.5 rounded-md text-[11px]",
    unstyled ? "" : config.className,
    // Nếu unstyled thì vẫn giữ màu chữ từ config nhưng bỏ các fallback class khác
    unstyled && config.className?.match(/text-[a-z0-9-]+/)?.[0],
    className
  )

  // Nếu không có config màu sắc đặc biệt, dùng variant của Shadcn
  const badgeVariant = config.className ? "default" : (variant as any)

  return (
    <Badge variant={badgeVariant} className={finalClassName}>
      {displayText}
    </Badge>
  )
}
